# SABOTAGE: ADR-053 P5: shared!/1 never registers the release of its owner, so every test leaks a shared 
#   sandbox owner into the next one
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/test_sandbox_test.exs
# MUST_FAIL: shared!/2 registers its own release - running it hands the pool back in :manual mode
diff --git a/samen_core/lib/samen/test_sandbox.ex b/samen_core/lib/samen/test_sandbox.ex
index db181c1..ac53b97 100644
--- a/samen_core/lib/samen/test_sandbox.ex
+++ b/samen_core/lib/samen/test_sandbox.ex
@@ -38,7 +38,6 @@ defmodule Samen.TestSandbox do
     # `:on_exit` is a seam for the helper's own test (a recorder instead of ExUnit's registry)
     register = Keyword.get(opts, :on_exit, &ExUnit.Callbacks.on_exit/1)
     owner = Sandbox.start_owner!(repo, shared: true)
-    register.(fn -> release(owner) end)
     owner
   end
 
