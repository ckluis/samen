# SABOTAGE: ADR-052 §2.1 item 3 (gate finding) — the framework composite-name form field
# (Samen.Web.CRM.Live.full_name_field/1) stops opening the in-flight %Samen.Pii.Plaintext{}.
# After a validate the vaulted full_name is the redacting wrapper; the `%{}` name_part clause
# matches the struct, finds no :first/:last, and re-renders BOTH inputs blank — the browser
# then resubmits the blank and the vault stores an erased name (data corruption).
#
# Flips the browser-emulating round-trip tests (Contact edit after phx-change, Contacts create
# after a failed submit).
# APP: samen_web
# TEST_FILES: test/samen/web/vault_form_roundtrip_test.exs
# MUST_FAIL: Contact EDIT: a phx-change re-render keeps the vaulted name
# MUST_FAIL: Contacts CREATE: a failed submit re-renders the typed name
diff --git a/samen_web/lib/samen/web/crm/live.ex b/samen_web/lib/samen/web/crm/live.ex
index 6ce4503..d5465e0 100644
--- a/samen_web/lib/samen/web/crm/live.ex
+++ b/samen_web/lib/samen/web/crm/live.ex
@@ -142,13 +142,8 @@ defmodule Samen.Web.CRM.Live do
   # Read one part of a NON-masked full-name value: the cast struct (after validate),
   # a raw map (nested params), the resolver's JSON string (tenant-plane read), or nil
   # (create form). NEVER a %Samen.Masked{} — that shape dispatches to form_field/1 above.
-  # After a validate the value is the caller's OWN pending input held as a redacting
-  # %Samen.Pii.Plaintext{} (ADR-052 §2.1); open it BEFORE the `%{}` clause, which would
-  # otherwise match the wrapper struct, find no :first/:last, and blank both inputs — the
-  # browser then resubmits the blank and the vault stores an erased name.
-  defp name_part(%Samen.Pii.Plaintext{} = pending, part),
-    do: name_part(Samen.Pii.Plaintext.unwrap(pending), part)
-
+  # SABOTAGE (ADR-052 §2.1): the in-flight %Samen.Pii.Plaintext{} is no longer opened — the
+  # `%{}` clause matches the wrapper, finds no :first/:last, and blanks both inputs.
   defp name_part(%Samen.Type.FullName{} = v, part), do: Map.get(v, part)
   defp name_part(%{} = m, part), do: Map.get(m, part) || Map.get(m, to_string(part))
 
