# SABOTAGE: Approvals.request errors on an already-pending approval instead of returning it, so a queue 
#   reader that lost the open race fails its re-open
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/reveal_approver_test.exs
# MUST_FAIL: a reader whose scan went stale (another reader opened the approval after it) converges on that ONE approval
diff --git a/samen_core/lib/samen/approvals.ex b/samen_core/lib/samen/approvals.ex
index 3242444d..2eb11b51 100644
--- a/samen_core/lib/samen/approvals.ex
+++ b/samen_core/lib/samen/approvals.ex
@@ -67,8 +67,8 @@ defmodule Samen.Approvals do
       # A pending-row read that FAILED is not "no pending approval": creating on top of an unreadable table would
       # open a duplicate (or lose the idempotent return), so the request is refused as unavailable instead.
       case existing_pending(res, attrs, opts) do
-        {:ok, approval} ->
-          {:ok, approval}
+        {:ok, _approval} ->
+          {:error, :request_failed}
 
         :none ->
           create_approval(res, repo, attrs, kind, opts)
