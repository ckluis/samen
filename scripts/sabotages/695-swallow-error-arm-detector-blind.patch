# SABOTAGE: The non-rescue detector stops matching a discarded {:error, _} arm, so a failed Ash/Repo read 
#   or write rendered as [] / nil / 0 / :ok passes the ratchet.
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/swallow_lint_test.exs
# MUST_FAIL: RED: an Ash read, a repo write and an Ash count whose error arm is a literal are flagged
# MUST_FAIL: every literal the detector names is flagged
diff --git a/samen_core/lib/samen/lint/swallow.ex b/samen_core/lib/samen/lint/swallow.ex
index b741eaaf..aa9058e2 100644
--- a/samen_core/lib/samen/lint/swallow.ex
+++ b/samen_core/lib/samen/lint/swallow.ex
@@ -289,7 +289,7 @@ defmodule Samen.Lint.Swallow do
 
   # `{:error, _}` / `{:error, _reason}` (the error is discarded). A bound-and-used reason cannot reach a
   # literal-only body, so only discarded errors qualify.
-  defp error_pattern?({:error, {name, _, ctx}}) when is_atom(name) and is_atom(ctx), do: underscored?(name)
+  defp error_pattern?({:error, {name, _, ctx}}) when is_atom(name) and is_atom(ctx), do: underscored?(name) and name == :never
   defp error_pattern?(_), do: false
 
   defp literal?({:__block__, _, [only]}), do: literal?(only)
