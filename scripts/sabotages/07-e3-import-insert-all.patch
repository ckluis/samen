     e -> %Report{report | errors: [%{row: n, error: Exception.message(e)} | report.errors]}
   end
 
+  # SABOTAGE helper (RP-CSV-2): a raw Ecto insert_all straight into the physical
+  # table — no governed action, no WriteGuard, no Vault.Change.
+  defp sabotage_insert_all(resource, attrs) do
+    repo = AshPostgres.DataLayer.Info.repo(resource, :read)
+    table = AshPostgres.DataLayer.Info.table(resource)
+    now = DateTime.utc_now()
+
+    row =
+      attrs
+      |> Map.put(:id, Ash.UUID.generate())
+      |> Map.put(:inserted_at, now)
+      |> Map.put(:updated_at, now)
+      |> Map.new(fn {k, v} -> {sabotage_source(resource, k), sabotage_dump(v)} end)
+
+    {1, _} = repo.insert_all(table, [row])
+    {:ok, :sabotaged}
+  end
+
+  defp sabotage_source(resource, name) do
+    case Ash.Resource.Info.attribute(resource, name) do
+      %{source: source} when not is_nil(source) -> source
+      _ -> name
+    end
+  end
+
+  defp sabotage_dump(%DateTime{} = v), do: v
+  defp sabotage_dump(v) when is_map(v) or is_list(v), do: Jason.encode!(v)
+
+  defp sabotage_dump(v) when is_binary(v) do
+    case Ecto.UUID.dump(v) do
+      {:ok, bin} -> bin
+      :error -> v
+    end
+  end
+
+  defp sabotage_dump(v), do: v
+
