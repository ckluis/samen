# SABOTAGE: the CSV export builds its scope with Mount.scope again, so a viewer exports as a member
#
# Flips the named test(s).
# APP: samen_web
# TEST_FILES: test/samen/web/tenant_role_surfaces_test.exs
# MUST_FAIL: CSV export acts as the RESOLVED role
diff --git a/samen_web/lib/samen/web/csv/export_controller.ex b/samen_web/lib/samen/web/csv/export_controller.ex
index f6664c55..e93378a1 100644
