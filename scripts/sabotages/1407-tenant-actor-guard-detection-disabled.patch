# SABOTAGE: the guard detector counts nothing, so a new implicit fixed-role scope call goes unreported
#
# Flips the named test(s).
# APP: samen_web
# TEST_FILES: test/samen/web/tenant_actor_guard_test.exs
# MUST_FAIL: a modeled new file with an implicit call would be reported
diff --git a/samen_web/lib/samen/web/tenant_actor/guard.ex b/samen_web/lib/samen/web/tenant_actor/guard.ex
index 586d52cb..d9961da6 100644
--- a/samen_web/lib/samen/web/tenant_actor/guard.ex
+++ b/samen_web/lib/samen/web/tenant_actor/guard.ex
@@ -16,6 +16,11 @@ defmodule Samen.Web.TenantActor.Guard do
   @doc "How many implicit fixed-role scope calls `source` makes (comment lines are ignored)."
   @spec implicit_calls(String.t()) :: non_neg_integer()
   def implicit_calls(source) when is_binary(source) do
+    _ = source
+    0
+  end
+
+  def implicit_calls_disabled(source) do
     source
     |> String.split("\n")
     |> Enum.reject(&String.match?(&1, ~r/^\s*#/))
