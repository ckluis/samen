# SABOTAGE: a ledger entry with an empty required substring passes the preflight, so it can never name the 
#   refusal it stands for
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/meta/ci_driver_guard_test.exs
# MUST_FAIL: LEDGER a mutation refused at build time is killed only when it is listed
diff --git a/scripts/sabotage_lint.sh b/scripts/sabotage_lint.sh
index ad08a921..6af7e0f6 100755
--- a/scripts/sabotage_lint.sh
+++ b/scripts/sabotage_lint.sh
@@ -54,7 +54,7 @@ if [[ -f "$LEDGER" ]]; then
     /^[[:space:]]*$/ || /^#/ { next }
     NF != 3 { printf "SABOTAGE LINT: BUILD_REFUSED.tsv:%d — want exactly 3 tab-separated columns (patch, required substring, reason)\n", NR; next }
     { if ($1 !~ /^[A-Za-z0-9._-]+$/ || system("test -f \"" dir "/" $1 "\"") != 0) printf "SABOTAGE LINT: BUILD_REFUSED.tsv:%d — names a patch that does not exist: \047%s\047\n", NR, $1 }
-    $2 ~ /^[[:space:]]*$/ { printf "SABOTAGE LINT: BUILD_REFUSED.tsv:%d — %s has an empty required substring\n", NR, $1 }
+    $2 ~ /^NEVER$/ { printf "SABOTAGE LINT: BUILD_REFUSED.tsv:%d — %s has an empty required substring\n", NR, $1 }
     $3 ~ /^[[:space:]]*$/ { printf "SABOTAGE LINT: BUILD_REFUSED.tsv:%d — %s has an empty reason\n", NR, $1 }
     ($1 in seen) { printf "SABOTAGE LINT: BUILD_REFUSED.tsv:%d — %s is listed twice\n", NR, $1 }
     { seen[$1] = 1 }
