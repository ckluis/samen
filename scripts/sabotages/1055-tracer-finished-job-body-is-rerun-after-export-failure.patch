diff --git a/samen_core/lib/samen/tracer.ex b/samen_core/lib/samen/tracer.ex
index 4088cddc..d283da24 100644
--- a/samen_core/lib/samen/tracer.ex
+++ b/samen_core/lib/samen/tracer.ex
@@ -320,7 +320,8 @@ defmodule Samen.Tracer do
           # the body ran and finished; the tracing plumbing failed afterwards: its result stands
           {:done, result} ->
             Samen.Observability.Failure.report_write(:job_span_finish, nil, e)
