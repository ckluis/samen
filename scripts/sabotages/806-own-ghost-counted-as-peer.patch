# SABOTAGE: a leftover of the lease own earlier session is counted as a second instance
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/single_node_lease_test.exs
# MUST_FAIL: a lock + variable left on a session the lease no longer owns
diff --git a/samen_core/lib/samen/single_node/lease.ex b/samen_core/lib/samen/single_node/lease.ex
index edeca69e..ad2e4af3 100644
--- a/samen_core/lib/samen/single_node/lease.ex
+++ b/samen_core/lib/samen/single_node/lease.ex
@@ -270,7 +270,7 @@ defmodule Samen.SingleNode.Lease do
             # A holder carrying MY boot epoch is a ghost of my own earlier session (a connection the server has
             # not dropped yet, or a pooled server connection still holding my locks): epochs are microseconds of
             # the database clock, unique per lease process, so it can never be a second instance.
-            others = Enum.reject(others, &(&1.epoch == ctx.epoch))
+            others = others
             if shared_session?(mine, ctx), do: {:unknown, :connection_pooler}, else: {:view, others}
         end
     end
