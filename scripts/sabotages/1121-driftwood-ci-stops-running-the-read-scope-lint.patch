# SABOTAGE: driftwood/ci.sh stops running the read-scope lint, so an unscoped read added to driftwood/lib 
#   ships unnoticed by its gate.
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/read_scope_verify_test.exs
# MUST_FAIL: every host's lib/ passes, and its ci.sh pins EXACTLY the measured sanction count
diff --git a/driftwood/ci.sh b/driftwood/ci.sh
index d2f860cf..37b31f56 100755
--- a/driftwood/ci.sh
+++ b/driftwood/ci.sh
@@ -136,7 +136,7 @@ echo "    PASSED"
 # 14a. read_scope (T132/S15): no `authorize?: false` read in this app's lib/ bypasses org scoping. The
 #      ceiling is this app's exact `# authz-scope:` count; a new sanctioned read is a conscious change to it.
 echo "--- step 14a/20: mix samen.verify.read_scope (read-scope lint)"
-mix samen.verify.read_scope --max-sanctioned 1
+true
 echo "    PASSED"
 
