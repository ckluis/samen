# SABOTAGE: A reviewed entry stops being pinned to its clause count, so a swallow added to an 
#   already-reviewed function is absorbed by the entry and the ratchet never sees it.
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/swallow_lint_test.exs
# MUST_FAIL: RED: a clause ADDED to an already-reviewed function counts
diff --git a/samen_core/lib/samen/lint/swallow.ex b/samen_core/lib/samen/lint/swallow.ex
index 8a05ab6a..5a3d3d4c 100644
--- a/samen_core/lib/samen/lint/swallow.ex
+++ b/samen_core/lib/samen/lint/swallow.ex
@@ -153,8 +153,8 @@ defmodule Samen.Lint.Swallow do
       |> Enum.flat_map(fn {fun, fun_sites} ->
         case Map.get(reviewed, {rel, fun}) do
           {pinned, hash, _reason} when is_integer(pinned) ->
-            taken = Enum.take(fun_sites, pinned)
-            if length(taken) == pinned and hash_of(taken) == hash, do: taken, else: []
+            taken = fun_sites
+            if hash == hash, do: taken, else: []
 
           _ ->
             []
