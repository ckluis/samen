# SABOTAGE: pawchart MCP resolver promotes a role-less key to :member instead of refusing it
#
# Flips the named test(s).
# APP: pawchart
# TEST_FILES: test/mcp_auth_test.exs
# MUST_FAIL: a key with NO minter_role
diff --git a/pawchart/lib/pawchart_web/api/mcp_key_resolver.ex b/pawchart/lib/pawchart_web/api/mcp_key_resolver.ex
index f0adb373..d89b06e8 100644
--- a/pawchart/lib/pawchart_web/api/mcp_key_resolver.ex
+++ b/pawchart/lib/pawchart_web/api/mcp_key_resolver.ex
@@ -50,9 +50,7 @@ defmodule PawChartWeb.Api.McpKeyResolver do
         # A key with no/unknown `minter_role` authorizes nothing (`Samen.Scope.ApiKey.authorized?/4`
