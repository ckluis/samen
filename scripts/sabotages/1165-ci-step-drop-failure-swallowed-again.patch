# SABOTAGE: a CI step's mix ecto.drop gets its || true back: a failed drop is swallowed and the step 
#   verifies whatever database is left
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/meta/test_db_guard_test.exs
# MUST_FAIL: no CI step or script swallows a database drop with `|| true`
diff --git a/ci/steps.conf b/ci/steps.conf
index f91b663d..ee1f9379 100644
--- a/ci/steps.conf
+++ b/ci/steps.conf
@@ -680,7 +680,7 @@ actions_job = app_pawchart
 
 [step verify_indexes_demo]
 cmd = mix deps.get --quiet
-    MIX_ENV=test mix ecto.drop --quiet
+    MIX_ENV=test mix ecto.drop --quiet || true
     MIX_ENV=test mix ecto.create --quiet
     MIX_ENV=test mix ecto.migrate --quiet
     MIX_ENV=test mix samen.verify.indexes
