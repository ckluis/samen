#   a run expires with its write proposal still approvable.
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/ai/agent_write_test.exs
# MUST_FAIL: RED: a run whose transcript was SHREDDED still has its approval withdrawn
diff --git a/samen_core/lib/samen/ai/agent.ex b/samen_core/lib/samen/ai/agent.ex
index 02b770e6..31fbec80 100644
