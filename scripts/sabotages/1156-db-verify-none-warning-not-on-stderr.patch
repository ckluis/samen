# SABOTAGE: The DATABASE_SSL_VERIFY=none warning stops going to stderr, the one channel that shows while a 
#   release evaluates runtime.exs.
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/deploy_db_ssl_test.exs
# MUST_FAIL: explicit none is the opt-out, and it WARNS
diff --git a/samen_core/lib/samen/deploy.ex b/samen_core/lib/samen/deploy.ex
index 55ee987c..c3f59674 100644
--- a/samen_core/lib/samen/deploy.ex
+++ b/samen_core/lib/samen/deploy.ex
@@ -60,7 +60,7 @@ defmodule Samen.Deploy do
 
       verify == "none" ->
         IO.puts(
-          :stderr,
+          :stdio,
           "[warning] DATABASE_SSL_VERIFY=none: the database server certificate is NOT verified; a man in the " <>
             "middle can read and alter the session. Use only on a private network, and prefer DATABASE_SSL_CACERTFILE."
         )
