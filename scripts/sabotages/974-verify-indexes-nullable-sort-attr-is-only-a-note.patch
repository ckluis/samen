# APP: samen_core
# TEST_FILES: test/indexing_test.exs
# MUST_FAIL: a SORT attribute that says non-nil over a nullable column is a violation; making the column NOT NULL clears it
diff --git a/samen_core/lib/mix/tasks/samen.verify.indexes.ex b/samen_core/lib/mix/tasks/samen.verify.indexes.ex
