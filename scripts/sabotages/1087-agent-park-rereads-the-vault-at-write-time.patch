# SABOTAGE: a write proposal's park reveals the vault a second time to write its transcript, so a blip
#   leaves a pending approval on a failed run
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/ai/agent_transcript_write_test.exs
# MUST_FAIL: RED: a vault failure during a proposing turn leaves no pending approval
diff --git a/samen_core/lib/samen/ai/agent.ex b/samen_core/lib/samen/ai/agent.ex
index 049a1655..a080ad08 100644
--- a/samen_core/lib/samen/ai/agent.ex
+++ b/samen_core/lib/samen/ai/agent.ex
@@ -2642,7 +2642,7 @@ defmodule Samen.AI.Agent do
       Map.merge(
         %{
           next_turn_at: park_deadline(approval),
-          transcript: encode_transcript(views, goal, lines, pending, shape)
+          transcript: encode_transcript(fresh_views!(run, views), goal, lines, pending, shape)
         },
         spend_attrs(run, spent(completion.usage))
       )
@@ -3668,6 +3668,11 @@ defmodule Samen.AI.Agent do
     {:error, :transcript_unavailable}
   end
 
+  defp fresh_views!(run, _views) do
+    {:ok, {_goal, _lines, _pending, fresh}} = transcript_state(reload!(run))
+    fresh
+  end
+
   # The history, the pending proposal AND the carried views, all decoded from ONE reveal: a transcript write that
   # follows this read appends to exactly the blob it read, and never reveals the vault a second time (a second reveal
   # has side effects between the two: an opened approval, an executed tool, a billed provider call).
