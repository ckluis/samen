# SABOTAGE: the closed turn shape admits a system role, so a turn could carry instruction-role content the 
#   seal never vouched for
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/ai/agent_conversation_test.exs
# MUST_FAIL: RED: anything outside the closed turn shape refuses (structs, tuples, extra keys, unknown roles/blocks)
diff --git a/samen_core/lib/samen/ai/chokepoint.ex b/samen_core/lib/samen/ai/chokepoint.ex
index 03319493..d36bd9e5 100644
--- a/samen_core/lib/samen/ai/chokepoint.ex
+++ b/samen_core/lib/samen/ai/chokepoint.ex
@@ -735,7 +735,7 @@ defmodule Samen.AI.Chokepoint do
   # list of known blocks. Anything else — an extra key, an unknown block type, a non-binary
   # text — is not a turn this boundary knows how to vouch for, so it refuses.
   defp turn_shape?(%{"role" => role, "content" => [_ | _] = blocks} = turn)
-       when role in ["user", "assistant"] and map_size(turn) == 2,
+       when role in ["user", "assistant", "system"] and map_size(turn) == 2,
        do: Enum.all?(blocks, &block_shape?/1)
 
   defp turn_shape?(_turn), do: false
