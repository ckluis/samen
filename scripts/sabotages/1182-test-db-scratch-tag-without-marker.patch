# SABOTAGE: the TestDb scratch grammar accepts any word and digits after test again, so test_results_2 is 
#   droppable
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/test_db_test.exs
# MUST_FAIL: a word and digits after test is not a scratch tag
diff --git a/samen_core/lib/samen/test_db.ex b/samen_core/lib/samen/test_db.ex
index e2e9f7d..4aab823 100644
--- a/samen_core/lib/samen/test_db.ex
+++ b/samen_core/lib/samen/test_db.ex
@@ -64,7 +64,7 @@ defmodule Samen.TestDb do
   """
 
   @maintenance_default "postgres"
-  @test_name ~r/\A(?:[A-Za-z0-9]+_)*test\d*(?:_lane\d+)*(?:_scratch_[A-Za-z][A-Za-z0-9]*_\d+(?:_\d+)*)*\z|\A[A-Za-z0-9_]+_downcheck_[0-9a-f]{8}\z/
+  @test_name ~r/\A(?:[A-Za-z0-9]+_)*test\d*(?:_lane\d+)*(?:_(?:scratch_)?[A-Za-z][A-Za-z0-9]*_\d+(?:_\d+)*)*\z|\A[A-Za-z0-9_]+_downcheck_[0-9a-f]{8}\z/
   @in_use "55006"
   @autovacuum_wait_ms 30_000
   @poll_ms 100
