# SABOTAGE: ADR-052 §2.2.1 (gate fix) — a non_pii!-cleared freeform column is recorded BY VALUE
# (the pre-gate rule): its plaintext is copied into replay_frame, where the erasure arm that
# overwrites the domain row on shred never reaches it.
#
# Flips the by-reference test.
# APP: samen_core
# TEST_FILES: test/replay/sanitizer_test.exs
# MUST_FAIL: a two-reviewer non_pii!-cleared freeform column is recorded BY REFERENCE
diff --git a/samen_core/lib/samen/replay/sanitizer.ex b/samen_core/lib/samen/replay/sanitizer.ex
index 46c7089..a65ddf6 100644
--- a/samen_core/lib/samen/replay/sanitizer.ex
+++ b/samen_core/lib/samen/replay/sanitizer.ex
@@ -431,7 +431,7 @@ defmodule Samen.Replay.Sanitizer do
 
   # A structural column holding a string is an id (UUID) or nothing: no record string is kept.
   defp attribute(:keep, _name, value, _plan, _pk, _depth, _walk) when is_binary(value),
-    do: string(value)
+    do: if(uuid?(value), do: string(value), else: %Kept{value: value})
 
   defp attribute(:keep, _name, value, _plan, _pk, depth, walk), do: walk(value, depth + 1, walk)
   defp attribute(:free, _name, value, _plan, _pk, _depth, _walk), do: free_text(value)
@@ -491,7 +491,8 @@ defmodule Samen.Replay.Sanitizer do
   # structural kind → kept; anything else → shape only.
   defp decision(_attr, true, _class), do: :ref
   defp decision(%{sensitive?: true}, false, _class), do: :free
-  defp decision(_attr, false, :metadata), do: :ref
+  # SABOTAGE (ADR-052 §2.2.1): a cleared column is kept by value.
+  defp decision(_attr, false, :metadata), do: :keep
   defp decision(_attr, false, class) when class in @projected_kinds, do: :keep
   defp decision(_attr, false, _class), do: :free
 
