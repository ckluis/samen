# SABOTAGE: The swallow ratchet stops recognising a catch-all rescue, so a new bare 'rescue _ -> []' in a 
#   read helper (an outage rendered as an empty page) passes the gate.
#
# Flips the named test(s).
# APP: samen_web
# TEST_FILES: test/samen/web/reads_swallow_lint_test.exs
# MUST_FAIL: RED: flags a function-level
# MUST_FAIL: non-vacuity: the scanner sees the tree
diff --git a/samen_core/lib/samen/lint/swallow.ex b/samen_core/lib/samen/lint/swallow.ex
index b741eaaf..64dfe3f7 100644
--- a/samen_core/lib/samen/lint/swallow.ex
+++ b/samen_core/lib/samen/lint/swallow.ex
@@ -216,7 +216,7 @@ defmodule Samen.Lint.Swallow do
 
   defp rescue_clause(_fun, _key, _other, acc), do: acc
 
-  defp catch_all?(:rescue, [pattern]), do: variable?(pattern)
+  defp catch_all?(:rescue, [_pattern]), do: false
 
   defp catch_all?(:catch, patterns),
     do: patterns != [] and Enum.all?(patterns, &(variable?(&1) or &1 in [:exit, :throw, :error]))
