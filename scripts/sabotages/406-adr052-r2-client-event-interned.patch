@@ -56,10 +56,9 @@ defmodule Samen.Observability.LiveEvents do
   """
   @spec resolve(module() | term(), term()) :: atom()
   def resolve(module, event) when is_atom(module) and is_binary(event) do
-    case Map.fetch(events(module), event) do
-      {:ok, atom} -> atom
-      :error -> @other
-    end
+    # SABOTAGE (ADR-052 R2): the client-sent event string is passed through raw — interned.
+    _ = events(module)
+    String.to_atom(event)
   end
 
   def resolve(_module, _event), do: @other
