# SABOTAGE: the reference fleet credential store (`Samen.Fleet.LocalCredential.Agent`,
# the app-side default of `LocalCredential.impl/0`) is started with `start_link` again,
# so it is LINKED to whichever process first calls it. When that caller exits
# non-normally (a request or job crashing, ExUnit's `:shutdown` at the end of a test),
# the store dies with it and every stored credential silently vanishes: `fetch/1` then
# answers `:not_configured` and the fleet wire 503s.
#
# Flips the shutdown-survival test. The positive control (put/fetch/reset in one live
# process) stays green, which is why this regression only ever showed up as a flake.
# APP: samen_core
# TEST_FILES: test/fleet_local_credential_agent_test.exs
# MUST_FAIL: a credential stored by a process that then shuts down is still there
diff --git a/samen_core/lib/samen/fleet/local_credential.ex b/samen_core/lib/samen/fleet/local_credential.ex
index 9246f8b..d29662d 100644
--- a/samen_core/lib/samen/fleet/local_credential.ex
+++ b/samen_core/lib/samen/fleet/local_credential.ex
@@ -97,7 +97,8 @@ defmodule Samen.Fleet.LocalCredential do
     defp ensure_started do
       case Process.whereis(@name) do
         nil ->
-          case Elixir.Agent.start(fn -> %{} end, name: @name) do
+          # SABOTAGE: the store is linked to its first caller again.
+          case Elixir.Agent.start_link(fn -> %{} end, name: @name) do
             {:ok, _pid} -> :ok
             {:error, {:already_started, _pid}} -> :ok
           end
