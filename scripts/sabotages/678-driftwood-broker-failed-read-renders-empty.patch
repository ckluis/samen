# SABOTAGE: The broker console turns a failed pane read into an empty list again, so a database outage 
#   renders 'No loads yet' with its create CTA and an empty driver roster
#
# Flips the named test(s).
# APP: driftwood
# TEST_FILES: test/reads_honest_failure_p4_test.exs
# MUST_FAIL: a failed load board is the error state with a retry
# MUST_FAIL: a failed roster is the error state, not an empty roster
diff --git a/driftwood/lib/driftwood_web/broker_live.ex b/driftwood/lib/driftwood_web/broker_live.ex
index 901f6559..93f1ff51 100644
--- a/driftwood/lib/driftwood_web/broker_live.ex
+++ b/driftwood/lib/driftwood_web/broker_live.ex
@@ -151,7 +151,12 @@ defmodule DriftwoodWeb.BrokerLive do
   # one is `{value, nil}` or `{default, :unavailable | :forbidden}`.
   defp pane(false, default, _fun), do: {default, nil}
 
-  defp pane(true, default, fun), do: Guard.pane(fun.(), default)
+  defp pane(true, default, fun) do
+    case fun.() do
+      {:ok, value} -> {value, nil}
+      {:error, _kind} -> {default, nil}
+    end
+  end
 
   # The dashboard rollup (`dbs_broker_summary`) through the same convention. A malformed org id (a
   # dogfood `?org=` param) is cast first: it is "no rollup", never an error log.
