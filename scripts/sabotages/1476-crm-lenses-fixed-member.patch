# SABOTAGE: The pipeline, calendar, dashboard, mailbox and gallery lenses act on the fixed member scope 
#   again instead of the signed-in person's role
#
# Flips the named test(s).
# APP: samen_web
# TEST_FILES: test/samen/web/tenant_role_crm_work_test.exs
# MUST_FAIL: every page of the CRM remainder and Work acts with the RESOLVED role
diff --git a/samen_web/lib/samen/web/crm/calendar_live.ex b/samen_web/lib/samen/web/crm/calendar_live.ex
index 0b8c793..177695b 100644
--- a/samen_web/lib/samen/web/crm/calendar_live.ex
+++ b/samen_web/lib/samen/web/crm/calendar_live.ex
@@ -86,7 +86,7 @@ defmodule Samen.Web.CRM.CalendarLive do
   # ADR-045 §4.4 - WHO acts: the signed-in person's resolved membership role (`Samen.Web.TenantActor`), never
   # `Mount.scope/2`'s fixed `:member`. A denial or a failed lookup is a STATE of the page: nothing is read.
   def load(socket, org_id, month) do
-    case TenantActor.assign_actor(socket, org_id) do
+    case {:ok, Phoenix.Component.assign(socket, acting_scope: Samen.Web.Mount.scope(socket.assigns.samen_mount, org_id), actor_state: :ok)} do
       {:ok, socket} -> load_for(socket, org_id, month, socket.assigns.acting_scope)
       {:refused, socket} -> load_refused(socket, org_id, month)
     end
