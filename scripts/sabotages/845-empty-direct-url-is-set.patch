#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/templates_parity_test.exs
# MUST_FAIL: every emitted file is byte-identical to the frozen golden fixture
diff --git a/samen_core/priv/templates/runtime_exs.eex b/samen_core/priv/templates/runtime_exs.eex
index d3d3fd41..f9c16b9f 100644
--- a/samen_core/priv/templates/runtime_exs.eex
+++ b/samen_core/priv/templates/runtime_exs.eex
@@ -63,7 +63,7 @@ if config_env() == :prod do
