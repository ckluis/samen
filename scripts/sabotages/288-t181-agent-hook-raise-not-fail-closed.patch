+    # happen, never make the call happen without its policy.
     hook.call(point, ctx)
   rescue
-    _ -> :__hook_error__
+    _ -> :ok
   catch
-    _kind, _value -> :__hook_error__
+    _kind, _value -> :ok
   end
 
