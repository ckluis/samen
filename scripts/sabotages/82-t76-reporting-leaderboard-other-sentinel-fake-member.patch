         # the display count — this ordering is the whole MED-1 fix: cap comes AFTER rank.
         ranked =
           series.points
-          |> Enum.reject(&(&1.key == other))
           |> Enum.sort_by(&(-&1.value))

         shown = Enum.take(ranked, top)
