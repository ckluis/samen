# SABOTAGE: issue #11 — `samen_anthropic` no longer recognises `stop_reason:
# "model_context_window_exceeded"` (HTTP 200: generation filled the context window, the
# response is TRUNCATED, and it reports what it spent). The response falls through to the
# success clause, so the agent loop accepts a truncated answer as a finished turn and the
# tokens are never billed as a failed attempt — the usage-carrying overflow ADR-048 §6
# Level 2 constraint 1 is about, silently swallowed.
#
# Flips the window-exceeded test. The normal-completion control stays green.
# APP: samen_anthropic
# TEST_FILES: test/provider_test.exs
# MUST_FAIL: a 200 that filled the context window is a usage-carrying :context_overflow, never a completion
diff --git a/samen_anthropic/lib/samen_anthropic/provider.ex b/samen_anthropic/lib/samen_anthropic/provider.ex
index e7a42310..d0a572db 100644
--- a/samen_anthropic/lib/samen_anthropic/provider.ex
+++ b/samen_anthropic/lib/samen_anthropic/provider.ex
@@ -257,13 +257,12 @@ defmodule SamenAnthropic.Provider do
     usage = normalize_usage(Map.get(body, "usage", %{}))
 
     case Map.get(body, "stop_reason") do
-      reason when reason in ["end_turn", "stop_sequence", "tool_use"] ->
+      # SABOTAGE (#11): a response that filled the context window is no longer recognised;
+      # it falls through to the success clause and is handed back as a completion.
+      reason
+      when reason in ["end_turn", "stop_sequence", "tool_use", "model_context_window_exceeded"] ->
         completion(body, reason, usage, model)
 
-      # Generation filled the context window: truncated, and it spent tokens.
-      "model_context_window_exceeded" ->
-        {:error, :context_overflow, usage}
-
       # Cut off at the output limit: not an answer, and the tokens were spent.
       "max_tokens" ->
         {:error, :truncated, usage}
