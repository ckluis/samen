-    Logger.info(
-      "[Lifecycle.EmailWorker] ESP THROTTLED — snoozing #{seconds}s (no attempt burned) " <>
-        "event=#{event} send_id=#{message.send_id} org_id=#{message.org_id}"
-    )
-  end
