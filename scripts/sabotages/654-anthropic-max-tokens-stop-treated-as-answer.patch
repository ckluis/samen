@@ -257,17 +257,14 @@ defmodule SamenAnthropic.Provider do
     usage = normalize_usage(Map.get(body, "usage", %{}))
 
     case Map.get(body, "stop_reason") do
-      reason when reason in ["end_turn", "stop_sequence", "tool_use"] ->
+      # SABOTAGE: a response cut off at max_tokens is handed back as a finished answer.
