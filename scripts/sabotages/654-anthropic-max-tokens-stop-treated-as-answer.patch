#   its output limit — as a finished completion, so a truncated FINAL: becomes the run's answer and 
#   its spend is never billed as a failed attempt
#
# Flips the named test(s).
# APP: samen_anthropic
# TEST_FILES: test/provider_test.exs
# MUST_FAIL: max_tokens is NOT a finished answer: a usage-carrying :truncated, the text never handed back
diff --git a/samen_anthropic/lib/samen_anthropic/provider.ex b/samen_anthropic/lib/samen_anthropic/provider.ex
