# SABOTAGE: a decision reads the request status without the row lock, so it never waits for a concurrent 
#   holder
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/reveal_request_lock_test.exs
# MUST_FAIL: approve, deny and re-open WAIT for a request another connection holds
diff --git a/samen_core/lib/samen/reveal/grants.ex b/samen_core/lib/samen/reveal/grants.ex
index ae1abc97..c18999fd 100644
--- a/samen_core/lib/samen/reveal/grants.ex
+++ b/samen_core/lib/samen/reveal/grants.ex
@@ -312,7 +312,7 @@ defmodule Samen.Reveal.Grants do
 
   # Under the lock: `:ok` while the request is still pending, else why not.
   defp lock_pending(r, request_id) do
-    case lock_request(r, request_id) do
+    case r.get(RevealRequest, request_id) do
       %RevealRequest{status: "pending"} -> :ok
       %RevealRequest{} -> {:error, :not_pending}
       nil -> {:error, :request_not_found}
