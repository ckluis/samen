# SABOTAGE: Samen.TestDb drops without WITH (FORCE): a lingering session blocks the drop and the race 
#   returns
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/test_db_test.exs
# MUST_FAIL: reset! succeeds with a live second connection and the database is fresh
diff --git a/samen_core/lib/samen/test_db.ex b/samen_core/lib/samen/test_db.ex
index 7f04ad73..b8368192 100644
--- a/samen_core/lib/samen/test_db.ex
+++ b/samen_core/lib/samen/test_db.ex
@@ -53,7 +53,7 @@ defmodule Samen.TestDb do
     db = db!(config)
     guard!(db)
 
-    case run(config, "DROP DATABASE IF EXISTS #{quote_ident(db)} WITH (FORCE)") do
+    case run(config, "DROP DATABASE IF EXISTS #{quote_ident(db)}") do
       :ok -> :ok
       {:error, error} -> raise "Samen.TestDb: could not drop database #{inspect(db)}: #{format(error)}"
     end
