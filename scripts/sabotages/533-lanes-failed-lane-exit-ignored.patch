# SABOTAGE: ADR-053 C7 — a lane's non-zero exit is no longer reported as that lane FAILING (it falls 
#   through to the accounting comparison, so the failure is no longer attributed to the lane that 
#   crashed).
#
# Flips the named test(s).
# APP: samen_core
# TEST_FILES: test/meta/ci_driver_guard_test.exs
# MUST_FAIL: C7 the N-lane corpus fails unless the patches processed across its lanes equal the selected count
diff --git a/scripts/sabotage-lanes.sh b/scripts/sabotage-lanes.sh
index 3f01edd..9534014 100755
--- a/scripts/sabotage-lanes.sh
+++ b/scripts/sabotage-lanes.sh
@@ -201,7 +201,7 @@ for (( k = 1; k <= LANES; k++ )); do
   if [[ -z "${n:-}" ]]; then
     problems+=("lane $k printed no PROCESSED accounting line (exit $rc)")
     n=0; m=0
-  elif [[ "$rc" -ne 0 ]]; then
+  elif false; then
     problems+=("lane $k FAILED (exit $rc) after PROCESSED $n of $m")
   elif [[ "$n" -ne "$m" ]]; then
     problems+=("lane $k exited 0 but PROCESSED $n of $m — a short lane is not coverage")
