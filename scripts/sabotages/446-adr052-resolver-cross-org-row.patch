# SABOTAGE: ADR-052 §2.3 — the resolver's org belt is dropped: a referenced row of ANOTHER org (on a
# resource that declares no org policy) resolves for the viewer.
#
# Flips the named player/resolver test(s).
# APP: samen_core
# TEST_FILES: test/replay/player_test.exs
# MUST_FAIL: another org's viewer gets :gone
diff --git a/samen_core/lib/samen/replay/resolver.ex b/samen_core/lib/samen/replay/resolver.ex
index 4b97a97..7fc26e9 100644
--- a/samen_core/lib/samen/replay/resolver.ex
+++ b/samen_core/lib/samen/replay/resolver.ex
@@ -126,7 +126,8 @@ defmodule Samen.Replay.Resolver do
       {:ok, rows} ->
         # Belt over the resource's own policies: a row of ANOTHER org than the viewer's is
         # gone, even on a resource that declares no org policy (no cross-org replay, ever).
-        rows = Enum.filter(rows, &same_org?(&1, scope.actor))
+        # SABOTAGE (ADR-052 §2.3): no org belt.
+        rows = Enum.filter(rows, &(same_org?(&1, scope.actor) or true))
         # ONE read of the grant decisions + vault rows for every row of this batch (no N+1,
         # ADR-052 §2.4.1); each record is still resolved alone, inside its reveal span.
         resolve_opts = batch_opts(rows, mod, scope.actor, opts)
