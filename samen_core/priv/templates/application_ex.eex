defmodule <%= module %>.Application do
  @moduledoc "<%= module %> OTP application (scaffolded by mix samen.gen.app)."
  use Application

  @impl true
  def start(_type, _args) do
    children =
      if Application.get_env(:<%= otp_app %>, :start_repo?, true) do
        [
          <%= module %>.Repo,
          # T128: install the canonical Samen cron (default_crontab/0) at boot — modules
          # are loaded here, so the audit-partition roll-forward + the rest of the periodic
          # schedule run by default with no host action. No-op under test (plugins: false).
          {Oban, Samen.Jobs.install_default_cron(Application.fetch_env!(:samen_core, Oban))}
        ]
      else
        []
      end

    opts = [strategy: :one_for_one, name: <%= module %>.Supervisor]
    Supervisor.start_link(children, opts)
  end
end
