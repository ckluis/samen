defmodule <%= module %>.Application do
  @moduledoc "<%= module %> OTP application (scaffolded by mix samen.gen.app)."
  use Application

  @impl true
  def start(_type, _args) do
    children =
      if Application.get_env(:<%= otp_app %>, :start_repo?, true) do
        [
          <%= module %>.Repo,
          # T128 + B-OBAN: install the canonical Samen queue taxonomy
          # (default_queue_config/0) AND cron (default_crontab/0) at boot — modules are
          # loaded here (unlike in config.exs), so every queue a shipped worker or AshOban
          # trigger enqueues to gets a producer, and the audit-partition roll-forward plus
          # the rest of the periodic schedule run with no host action. A queue that is
          # enqueued-to but unconfigured never drains and never errors — this seam is what
          # makes that unrepresentable. No-op under test (plugins: false).
          {Oban, Samen.Jobs.install_defaults(Application.fetch_env!(:samen_core, Oban))}
        ]
      else
        []
      end

    opts = [strategy: :one_for_one, name: <%= module %>.Supervisor]
    Supervisor.start_link(children, opts)
  end
end
