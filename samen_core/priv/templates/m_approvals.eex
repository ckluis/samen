      add(:<%= approval_abbrev %>_subject_ref, :text, null: false)
      add(:<%= approval_abbrev %>_requested_by, :text, null: false)
      add(:<%= approval_abbrev %>_decided_by, :text)
      add(:<%= approval_abbrev %>_reason, :text)
