defmodule <%= module %>.Application do
  @moduledoc "<%= module %> OTP application (scaffolded by mix samen.gen.app)."
  use Application

  @impl true
  def start(_type, _args) do
    # ADR-045 §2 (V-F1) — the fail-secure tenant-auth BOOT GUARD. Refuses to boot this host in
    # PRODUCTION with the tenant gate disarmed (an unauthenticated `?org=` would resolve any
    # tenant's vaulted data in the clear). A no-op in dev/test; the framework twin of the ADR-024
    # `runtime.exs` prod-secret raise. The gate is armed by default in prod (config/config.exs +
    # `Samen.Web.TenantGate`), so this only fires if an operator EXPLICITLY set auth_required? false.
    Samen.Web.TenantGate.assert_prod_armed!(:<%= otp_app %>)

    # Observability plane (WS-D D1.1/D5): OTel-Ecto with the un-forgettable
    # db_statement: :disabled + metrics contention handlers, wired via the
    # framework helper instead of hand-copied setup calls. Follows the repo:
    # in :test start_repo? is false, so no Ecto telemetry exists to observe.
    repo_children =
      if Application.get_env(:<%= otp_app %>, :start_repo?, true) do
        Samen.Observability.child_specs(:<%= otp_app %>) ++
          [
            <%= module %>.Repo,
            # T128 + B-OBAN: install the canonical Samen queue taxonomy
            # (default_queue_config/0) AND cron (default_crontab/0) at boot — modules are
            # loaded here (unlike in config.exs), so every queue a shipped worker or AshOban
            # trigger enqueues to gets a producer, and the audit-partition roll-forward plus
            # the rest of the periodic schedule run with no host action. A queue that is
            # enqueued-to but unconfigured never drains and never errors — this seam is what
            # makes that unrepresentable. No-op under test (plugins: false).
            {Oban, Samen.Jobs.install_defaults(Application.fetch_env!(:samen_core, Oban))}
          ]
      else
        []
      end

    # The web plane (PubSub + Endpoint) starts whenever the repo runs (mirrors
    # pawchart/driftwood; the endpoint only SERVES when `server: true` — dev/prod).
    web_children =
      if Application.get_env(:<%= otp_app %>, :start_repo?, true) do
        [{Phoenix.PubSub, name: <%= module %>.PubSub}, <%= module %>Web.Endpoint]
      else
        []
      end

    opts = [strategy: :one_for_one, name: <%= module %>.Supervisor]
    Supervisor.start_link(repo_children ++ web_children, opts)
  end
end
