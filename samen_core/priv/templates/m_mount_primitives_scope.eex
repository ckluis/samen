    <%= module %>.Primitives.NotificationPreference,
    <%= module %>.Primitives.File,
    <%= module %>.Primitives.SearchIndex,
    <%= module %>.Primitives.Webhook,
    <%= module %>.Primitives.FeatureFlag
  ]

