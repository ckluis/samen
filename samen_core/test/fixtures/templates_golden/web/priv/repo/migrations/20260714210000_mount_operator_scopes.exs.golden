defmodule Acme.Repo.Migrations.MountOperatorScopes do
  @moduledoc """
  Mounts the OPERATOR namespace (ADR-010 §8.2) into the host's one Postgres: a SECOND
  mount of Identity + Billing + Support whose rows describe the SaaS company's OWN
  book of business — its tenant-org ACCOUNTS, their tenant-ADMINS (PII the SaaS owns,
  CLEAR), each tenant's subscription-to-the-SaaS (incl. the ADR-017 movement ledger),
  and the tickets tenants file WITH the SaaS. Mirrors driftwood's
  `mount_operator_scopes`. Catalogued in the SAME transaction (ADR-004 catalog-in-tx).

  PII columns hold vault `vt_*` tokens (plaintext never lands here):
    * `aou_user.aou_full_name` / `.aou_emails`
    * `apc_customer.pii_apc_billing_name` / `.pii_apc_billing_email`
    * `aqg_agent.aqg_full_name` / `.pii_aqg_email`,
      `aqm_message.pii_aqm_body`
  """
  use Samen.Migration

  @resources [
    # Identity (operator: accounts + admins)
    Acme.Operator.Org,
    Acme.Operator.User,
    Acme.Operator.Membership,
    Acme.Operator.Role,
    Acme.Operator.ApiKey,
    Acme.Operator.Invitation,
    # ADR-035 — the identity spine's two org-less resources (T02x integration).
    Acme.Operator.Credential,
    Acme.Operator.AuthToken,
    # ADR-035 §3.1/§4.3, §5 A6 — the identity spine's other two org-less resources
    # (T04's Session, T06's UserIdentity; T06x integration).
    Acme.Operator.Session,
    Acme.Operator.UserIdentity,
    # Billing (operator: tenant subscriptions-to-the-SaaS + the movement ledger)
    Acme.Operator.Customer,
    Acme.Operator.Subscription,
    Acme.Operator.Plan,
    Acme.Operator.Price,
    Acme.Operator.Invoice,
    Acme.Operator.Payment,
    Acme.Operator.Usage,
    Acme.Operator.Entitlement,
    Acme.Operator.SubscriptionEvent,
    # Support (operator: tenant-filed desk tickets)
    Acme.Operator.Sla,
    Acme.Operator.Ticket,
    Acme.Operator.Conversation,
    Acme.Operator.Agent,
    Acme.Operator.Message,
    Acme.Operator.Macro,
    Acme.Operator.Csat
  ]

  def up do
    # =====================================================================
    # IDENTITY — accounts (Org) + admins (User) + membership + role/key/invite
    # =====================================================================

    # --- aoo_org : the tenant anchor. Here: an ACCOUNT (a tenant org
    #     mirrored). The slug carries the tenant_org_id back-reference (Bridge-B). ---
    create table(:aoo_org, primary_key: false) do
      add(:aoo_name, :text, null: false)
      add(:aoo_slug, :text)
      add(:aoo_plan, :text, default: "free")
      # ADR-035 §4.3/§5 A4 (spec-questions c3, T04) — the OPTIONAL org-level
      # concurrent-session cap; nil = unlimited (the default).
      add(:aoo_max_concurrent_sessions, :integer)
      # ADR-035 §5 A8 (T08) — set once the first-run onboarding wizard completes
      # (`Samen.Web.Onboarding.complete!/3`); nil until then (`needed?/3` reads it).
      add(:aoo_onboarded_at, :utc_datetime)
      add(:aoo_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:aoo_org_id, :uuid)
      add(:aoo_inserted_at, :utc_datetime, null: false)
      add(:aoo_updated_at, :utc_datetime, null: false)
    end

    # --- aou_user : the tenant-ADMIN 🔒 (full_name/emails vault-routed) ---
    create table(:aou_user, primary_key: false) do
      add(:aou_handle, :text)
      add(:aou_status, :text, default: "active")
      add(:aou_full_name, :text)
      add(:aou_emails, :text)
      add(:aou_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:aou_org_id, :uuid, null: false)
      add(:aou_inserted_at, :utc_datetime, null: false)
      add(:aou_updated_at, :utc_datetime, null: false)
    end

    # --- aom_membership : (user, org, role) ---
    create table(:aom_membership, primary_key: false) do
      add(:aom_role, :text, default: "member")
      add(:aom_status, :text, default: "active")

      add(
        :aom_user_id,
        references(:aou_user,
          column: :aou_id,
          name: "aom_membership_aom_user_id_fkey",
          type: :uuid,
          prefix: "public"
        )
      )

      add(:aom_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:aom_org_id, :uuid, null: false)
      add(:aom_inserted_at, :utc_datetime, null: false)
      add(:aom_updated_at, :utc_datetime, null: false)
    end

    # --- aor_role : Tier-0 config rows (per-org role catalog) ---
    create table(:aor_role, primary_key: false) do
      add(:aor_name, :text, null: false)
      add(:aor_label, :text)
      add(:aor_rank, :integer, null: false)
      add(:aor_enabled, :boolean, default: true)
      add(:aor_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:aor_org_id, :uuid, null: false)
      add(:aor_inserted_at, :utc_datetime, null: false)
      add(:aor_updated_at, :utc_datetime, null: false)
    end

    # --- aok_api_key : scoped credential (two planes) ---
    create table(:aok_api_key, primary_key: false) do
      add(:aok_token_digest, :text, null: false)
      add(:aok_plane, :text, null: false, default: "tenant")
      add(:aok_scopes, :map, default: fragment("'{}'::jsonb"))
      add(:aok_minter_role, :text)
      add(:aok_revoked_at, :utc_datetime)
      # F3.4 — bounded API-key expiry (deny-on-read) + last-use observability.
      add(:aok_expires_at, :utc_datetime)
      add(:aok_last_used_at, :utc_datetime)

      add(
        :aok_membership_id,
        references(:aom_membership,
          column: :aom_id,
          name: "aok_api_key_aok_membership_id_fkey",
          type: :uuid,
          prefix: "public"
        )
      )

      add(:aok_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:aok_org_id, :uuid, null: false)
      add(:aok_inserted_at, :utc_datetime, null: false)
      add(:aok_updated_at, :utc_datetime, null: false)
    end

    # --- aon_invitation : a pending invite 🔒 (email vault-routed).
    #     ADR-035 §4.1/§4.2/§5 A5 (T05 hardening): `token_digest` (SHA-256 digest at
    #     rest, the ApiKey precedent) + `email_bidx` (the §4.1 non-reversible keyed-HMAC
    #     lookup — accept-time credential matching never needs a vault reveal) +
    #     `expires_at`/`accepted_at`/`revoked_at` (the 4-state lifecycle's terminal
    #     timestamps). Mirrors demo/driftwood's `harden_identity_invitation` shape,
    #     emitted directly (fresh app — no rename dance needed). ---
    create table(:aon_invitation, primary_key: false) do
      add(:aon_role, :text, default: "member")
      add(:aon_status, :text, default: "pending")
      add(:aon_token_digest, :text)
      add(:aon_email_bidx, :text)
      add(:aon_expires_at, :utc_datetime)
      add(:aon_accepted_at, :utc_datetime)
      add(:aon_revoked_at, :utc_datetime)
      add(:aon_email, :text)
      add(:aon_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:aon_org_id, :uuid, null: false)
      add(:aon_inserted_at, :utc_datetime, null: false)
      add(:aon_updated_at, :utc_datetime, null: false)
    end

    create(unique_index(:aon_invitation, [:aon_token_digest]))

    # --- aoc_credential : THE authentication principal (org-less; ADR-035). ---
    create table(:aoc_credential, primary_key: false) do
      add(:aoc_email_bidx, :text, null: false)
      add(:aoc_password_hash, :text)
      add(:aoc_hash_scheme, :text)
      add(:aoc_verified_at, :utc_datetime)
      # ADR-035 §5 A7 (T07) — the TOTP 2FA columns the Identity Credential blueprint
      # declares. `pii_<abbrev>_totp_secret`/`pii_<abbrev>_recovery_codes` are 🔒
      # vault-routed (`:pii_secret` — `text` holding a `vt_*` token only, INV-1; the
      # scalar `pii_attribute` `pii_<abbrev>_<name>` storage prefix); the two
      # `*_totp_*_at` timestamps are plain non-PII. Without these four columns the
      # generated app has schema drift the moment TotpEnrollLive enrolls (the
      # driftwood `add_credential_totp_fields` migration, folded into this create).
      add(:pii_aoc_totp_secret, :text)
      add(:pii_aoc_recovery_codes, :text)
      add(:aoc_totp_enabled_at, :utc_datetime)
      add(:aoc_totp_last_verified_at, :utc_datetime)
      add(:aoc_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:aoc_org_id, :uuid)
      add(:aoc_inserted_at, :utc_datetime, null: false)
      add(:aoc_updated_at, :utc_datetime, null: false)
    end

    # ADR-035 §4.1 — the global "one account per email" invariant.
    create(unique_index(:aoc_credential, [:aoc_email_bidx]))

    # --- aot_auth_token : single-use, expiring, hashed-at-rest emailed secrets. ---
    create table(:aot_auth_token, primary_key: false) do
      add(:aot_token_digest, :text, null: false)
      add(:aot_context, :text, null: false)
      add(:aot_sent_to_bidx, :text)
      add(:aot_expires_at, :utc_datetime, null: false)
      add(:aot_consumed_at, :utc_datetime)

      add(
        :aot_credential_id,
        references(:aoc_credential,
          column: :aoc_id,
          name: "aot_auth_token_aot_credential_id_fkey",
          type: :uuid,
          prefix: "public"
        ),
        null: false
      )

      add(:aot_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:aot_org_id, :uuid)
      add(:aot_inserted_at, :utc_datetime, null: false)
      add(:aot_updated_at, :utc_datetime, null: false)
    end

    create(unique_index(:aot_auth_token, [:aot_token_digest]))

    # --- aos_session : a revocable, DB-backed login session (org-less;
    #     ADR-035 §3.1/§4.3, T04). No PII: device_label is a bounded browser/OS-family
    #     string (never the raw user-agent, never an IP); token_digest is the SHA-256
    #     digest of the raw session token (the ApiKey token_digest precedent) — never
    #     vault-routed, never allowlisted. ---
    create table(:aos_session, primary_key: false) do
      add(:aos_token_digest, :text, null: false)
      add(:aos_last_seen_at, :utc_datetime)
      add(:aos_expires_at, :utc_datetime, null: false)
      add(:aos_revoked_at, :utc_datetime)
      add(:aos_device_label, :text)

      add(
        :aos_credential_id,
        references(:aoc_credential,
          column: :aoc_id,
          name: "aos_session_aos_credential_id_fkey",
          type: :uuid,
          prefix: "public"
        ),
        null: false
      )

      add(:aos_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:aos_org_id, :uuid)
      # ADR-035 §4.3 A4 (T104) — microsecond precision so the concurrent-session
      # cap eviction sorts a total order (same-second sign-ins get a sub-second
      # creation key); mirrors the Identity.Session blueprint's usec inserted_at.
      add(:aos_inserted_at, :utc_datetime_usec, null: false)
      add(:aos_updated_at, :utc_datetime, null: false)
    end

    create(unique_index(:aos_session, [:aos_token_digest]))

    # --- aoi_user_identity : the SSO link (org-less; ADR-035 §3.1/§5 A6, T06) —
    #     binds an external IdP subject (provider + opaque provider_uid) to a Credential.
    #     No PII: provider is a bounded name and provider_uid is an IdP-scoped opaque
    #     handle — the IdP-asserted email is used only transiently for a bidx lookup at
    #     link time and, on JIT signup, vaulted on the aou_user row; it is
    #     NEVER persisted on this table (INV-1). ---
    create table(:aoi_user_identity, primary_key: false) do
      add(:aoi_provider, :text, null: false)
      add(:aoi_provider_uid, :text, null: false)
      add(:aoi_linked_at, :utc_datetime, null: false)

      add(
        :aoi_credential_id,
        references(:aoc_credential,
          column: :aoc_id,
          name: "aoi_user_identity_aoi_credential_id_fkey",
          type: :uuid,
          prefix: "public"
        ),
        null: false
      )

      add(:aoi_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:aoi_org_id, :uuid)
      add(:aoi_inserted_at, :utc_datetime, null: false)
      add(:aoi_updated_at, :utc_datetime, null: false)
    end

    create(unique_index(:aoi_user_identity, [:aoi_provider, :aoi_provider_uid]))

    # ADR-035 §3.1 — additive, nullable FK on the already-created aou_user table.
    alter table(:aou_user) do
      add(:aou_credential_id, :uuid)
    end

    # =====================================================================
    # BILLING — each tenant's subscription TO the SaaS
    # =====================================================================

    create table(:apc_customer, primary_key: false) do
      add(:apc_provider_customer_ref, :text)
      add(:apc_status, :text, default: "active")
      add(:apc_currency, :text, default: "USD")
      add(:apc_custom, :map, default: fragment("'{}'::jsonb"))
      add(:pii_apc_billing_name, :text)
      add(:pii_apc_billing_email, :text)
      add(:apc_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:apc_org_id, :uuid, null: false)
      add(:apc_inserted_at, :utc_datetime, null: false)
      add(:apc_updated_at, :utc_datetime, null: false)
    end

    create table(:app_plan, primary_key: false) do
      add(:app_name, :text, null: false)
      add(:app_label, :text)
      add(:app_description, :text)
      add(:app_provider_plan_ref, :text)
      add(:app_interval, :text, default: "monthly")
      add(:app_enabled, :boolean, default: true)
      add(:app_features, :map, default: fragment("'{}'::jsonb"))
      add(:app_custom, :map, default: fragment("'{}'::jsonb"))
      add(:app_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:app_org_id, :uuid, null: false)
      add(:app_inserted_at, :utc_datetime, null: false)
      add(:app_updated_at, :utc_datetime, null: false)
    end

    create table(:apr_price, primary_key: false) do
      add(:apr_provider_price_ref, :text)
      # ADR-036 H1/D7: one money_with_currency composite column (the type was
      # installed by the app_resources migration this one runs after).
      add(:apr_unit_amount, :money_with_currency, null: false)
      add(:apr_interval, :text, default: "monthly")
      add(:apr_active, :boolean, default: true)
      add(:apr_custom, :map, default: fragment("'{}'::jsonb"))

      add(
        :apr_plan_id,
        references(:app_plan,
          column: :app_id,
          name: "apr_price_apr_plan_id_fkey",
          type: :uuid,
          prefix: "public"
        )
      )

      add(:apr_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:apr_org_id, :uuid, null: false)
      add(:apr_inserted_at, :utc_datetime, null: false)
      add(:apr_updated_at, :utc_datetime, null: false)
    end

    create table(:aps_subscription, primary_key: false) do
      add(:aps_provider_subscription_ref, :text)
      add(:aps_status, :text, default: "active")
      add(:aps_current_period_start, :utc_datetime)
      add(:aps_current_period_end, :utc_datetime)
      add(:aps_trial_end, :utc_datetime)
      add(:aps_cancel_at, :utc_datetime)
      add(:aps_cancelled_at, :utc_datetime)
      add(:aps_custom, :map, default: fragment("'{}'::jsonb"))

      add(
        :aps_customer_id,
        references(:apc_customer,
          column: :apc_id,
          name: "aps_subscription_aps_customer_id_fkey",
          type: :uuid,
          prefix: "public"
        )
      )

      add(
        :aps_plan_id,
        references(:app_plan,
          column: :app_id,
          name: "aps_subscription_aps_plan_id_fkey",
          type: :uuid,
          prefix: "public"
        )
      )

      add(:aps_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:aps_org_id, :uuid, null: false)
      add(:aps_inserted_at, :utc_datetime, null: false)
      add(:aps_updated_at, :utc_datetime, null: false)
    end

    # T106 decision (e): DB-unique-fence on the provider-subscription-ref (mirror idempotency).
    create(unique_index(:aps_subscription, [:aps_provider_subscription_ref], name: "aps_subscription_provider_ref_index"))

    create table(:api_invoice, primary_key: false) do
      add(:api_provider_invoice_ref, :text)
      add(:api_status, :text, default: "draft")
      add(:api_amount_due_cents, :integer, default: 0)
      add(:api_amount_paid_cents, :integer, default: 0)
      add(:api_currency, :text, default: "USD")
      add(:api_period_start, :utc_datetime)
      add(:api_period_end, :utc_datetime)
      add(:api_due_date, :utc_datetime)
      add(:api_paid_at, :utc_datetime)
      add(:api_line_items, {:array, :map}, default: fragment("ARRAY[]::jsonb[]"))
      add(:api_tax_amount_cents, :integer)
      add(:api_tax_lines, {:array, :map}, default: fragment("ARRAY[]::jsonb[]"))
      add(:api_hosted_invoice_url, :text)
      add(:api_hosted_receipt_url, :text)
      add(:api_last_event_id, :text)
      add(:api_custom, :map, default: fragment("'{}'::jsonb"))

      add(
        :api_customer_id,
        references(:apc_customer,
          column: :apc_id,
          name: "api_invoice_api_customer_id_fkey",
          type: :uuid,
          prefix: "public"
        )
      )

      add(
        :api_subscription_id,
        references(:aps_subscription,
          column: :aps_id,
          name: "api_invoice_api_subscription_id_fkey",
          type: :uuid,
          prefix: "public"
        )
      )

      add(:api_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:api_org_id, :uuid, null: false)
      add(:api_inserted_at, :utc_datetime, null: false)
      add(:api_updated_at, :utc_datetime, null: false)
    end

    create table(:apy_payment, primary_key: false) do
      add(:apy_provider_payment_ref, :text)
      add(:apy_status, :text, default: "pending")
      add(:apy_amount_cents, :integer, null: false)
      add(:apy_currency, :text, default: "USD")
      add(:apy_payment_method_type, :text, default: "card")
      add(:apy_last4, :text)
      add(:apy_paid_at, :utc_datetime)
      add(:apy_failure_code, :text)
      add(:apy_custom, :map, default: fragment("'{}'::jsonb"))

      add(
        :apy_invoice_id,
        references(:api_invoice,
          column: :api_id,
          name: "apy_payment_apy_invoice_id_fkey",
          type: :uuid,
          prefix: "public"
        )
      )

      add(
        :apy_customer_id,
        references(:apc_customer,
          column: :apc_id,
          name: "apy_payment_apy_customer_id_fkey",
          type: :uuid,
          prefix: "public"
        )
      )

      add(:apy_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:apy_org_id, :uuid, null: false)
      add(:apy_inserted_at, :utc_datetime, null: false)
      add(:apy_updated_at, :utc_datetime, null: false)
    end

    create table(:apu_usage, primary_key: false) do
      add(:apu_metric, :text, null: false)
      add(:apu_quantity, :integer, default: 0)
      add(:apu_period_start, :utc_datetime)
      add(:apu_period_end, :utc_datetime)
      add(:apu_reported_at, :utc_datetime)

      add(
        :apu_subscription_id,
        references(:aps_subscription,
          column: :aps_id,
          name: "apu_usage_apu_subscription_id_fkey",
          type: :uuid,
          prefix: "public"
        )
      )

      add(:apu_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:apu_org_id, :uuid, null: false)
      add(:apu_inserted_at, :utc_datetime, null: false)
      add(:apu_updated_at, :utc_datetime, null: false)
    end

    create table(:ape_entitlement, primary_key: false) do
      add(:ape_feature, :text, null: false)
      add(:ape_granted, :boolean, default: true)
      add(:ape_expires_at, :utc_datetime)
      add(:ape_custom, :map, default: fragment("'{}'::jsonb"))

      add(
        :ape_subscription_id,
        references(:aps_subscription,
          column: :aps_id,
          name: "ape_entitlement_ape_subscription_id_fkey",
          type: :uuid,
          prefix: "public"
        )
      )

      add(
        :ape_plan_id,
        references(:app_plan,
          column: :app_id,
          name: "ape_entitlement_ape_plan_id_fkey",
          type: :uuid,
          prefix: "public"
        )
      )

      add(:ape_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:ape_org_id, :uuid, null: false)
      add(:ape_inserted_at, :utc_datetime, null: false)
      add(:ape_updated_at, :utc_datetime, null: false)
    end

    # --- Subscription-movement ledger (`mov`; ADR-017) — append-only, no PII,
    #     soft id refs (no FK: the immutable ledger outlives its subscription row) ---
    create table(:apv_subscription_event, primary_key: false) do
      add(:apv_subscription_id, :uuid, null: false)
      add(:apv_customer_id, :uuid)
      add(:apv_plan_id, :uuid)
      add(:apv_from_plan_id, :uuid)
      add(:apv_kind, :text, null: false)
      add(:apv_mrr_delta_cents, :integer, null: false, default: 0)
      add(:apv_mrr_before_cents, :integer, null: false, default: 0)
      add(:apv_mrr_after_cents, :integer, null: false, default: 0)
      add(:apv_from_status, :text)
      add(:apv_to_status, :text)
      add(:apv_reason, :text, default: "status_change")
      add(:apv_occurred_at, :utc_datetime, null: false)
      add(:apv_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:apv_org_id, :uuid, null: false)
      add(:apv_inserted_at, :utc_datetime, null: false)
      add(:apv_updated_at, :utc_datetime, null: false)
    end

    # =====================================================================
    # SUPPORT — the SaaS help desk (tenants file tickets WITH the SaaS)
    # =====================================================================

    create table(:aql_sla, primary_key: false) do
      add(:aql_name, :text, null: false)
