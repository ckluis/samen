    # Identity (operator: accounts + admins)
    Acme.Operator.Org,
    Acme.Operator.User,
    Acme.Operator.Membership,
    Acme.Operator.Role,
    Acme.Operator.ApiKey,
    Acme.Operator.Invitation,
    # Billing (operator: tenant subscriptions-to-the-SaaS + the movement ledger)
    Acme.Operator.Customer,
    Acme.Operator.Subscription,
    Acme.Operator.Plan,
    Acme.Operator.Price,
    Acme.Operator.Invoice,
    Acme.Operator.Payment,
    Acme.Operator.Usage,
    Acme.Operator.Entitlement,
    Acme.Operator.SubscriptionEvent,
    # Support (operator: tenant-filed desk tickets)
    Acme.Operator.Sla,
    Acme.Operator.Ticket,
    Acme.Operator.Conversation,
    Acme.Operator.Agent,
    Acme.Operator.Message,
    Acme.Operator.Macro,
    Acme.Operator.Csat
  ]

